PI_SSH_TARGET=camerauser@100.x.y.z
PI_TAILSCALE_IP=100.x.y.z
STREAM_NAME=cam-your-private-path
VIDEO_DEVICE=auto
CONTROL_PASSWORD_SHA256=replace-with-sha256
TAILSCALE_SERVE_DASHBOARD_URL=https://raspberrypi.your-tailnet.ts.net
TAILSCALE_SERVE_WEBRTC_URL=https://raspberrypi.your-tailnet.ts.net:8443/cam-your-private-path/

# Optional bounded rewind buffer. On the Pi, prefer /run so the SD card is not
# continuously written while the camera is on.
REWIND_ENABLED=true
REWIND_MINUTES=30
REWIND_SEGMENT_SECONDS=6
REWIND_MAX_MB=512
REWIND_DIR=/run/vantacam-rewind
REWIND_SOURCE_URL=rtsp://127.0.0.1:8554/cam-your-private-path
