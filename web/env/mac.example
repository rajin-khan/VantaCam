HOST=127.0.0.1
PORT=3100
STREAM_HOST=127.0.0.1
PUBLIC_STREAM_HOST=100.x.y.z
STREAM_PATH=cam-your-private-path
PUBLIC_WEBRTC_URL=
REMOTE_DASHBOARD_URL=http://100.x.y.z:3100
CORS_ORIGIN=
PUBLIC_DASHBOARD_API_BASE=
APP_PASSWORD_SHA256=replace-with-sha256
CONTROL_PASSWORD_SHA256=replace-with-sha256
SESSION_SECRET=use-the-same-secret-as-the-pi-dashboard
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
REWIND_ENABLED=true
REWIND_MINUTES=30
REWIND_SEGMENT_SECONDS=6
REWIND_MAX_MB=512
REWIND_DIR=/Users/you/Library/Application Support/VantaCam/rewind
REWIND_SOURCE_URL=rtsp://127.0.0.1:8554/cam-your-private-path
REWIND_TOKEN_SECONDS=900
