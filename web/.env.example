# Copy this to web/.env and fill in private values.
# Never commit web/.env.

HOST=127.0.0.1
PORT=3100

# The dashboard server uses STREAM_HOST for internal HLS proxying.
# On the Pi, use 127.0.0.1 because MediaMTX HLS is localhost-only.
STREAM_HOST=127.0.0.1

# Browsers use PUBLIC_STREAM_HOST for the embedded WebRTC stream.
PUBLIC_STREAM_HOST=100.x.y.z
STREAM_PATH=cam-your-private-path

# For the Vercel-hosted HTTPS dashboard, set this to the Tailscale Serve
# WebRTC URL, for example:
# https://raspberrypi.your-tailnet.ts.net:8443/cam-your-private-path/
PUBLIC_WEBRTC_URL=

# Optional: set this when running the Web UI on your Mac and forwarding
# status/control calls to the Pi-hosted dashboard.
REMOTE_DASHBOARD_URL=

# Set CORS_ORIGIN on the Pi to the exact Vercel URL that should be allowed
# to call the private dashboard API from your browser.
CORS_ORIGIN=

# Set PUBLIC_DASHBOARD_API_BASE only when this same static UI is hosted away
# from the Pi and should call the Pi backend directly.
PUBLIC_DASHBOARD_API_BASE=

# Store SHA-256 hashes, not plaintext passwords.
APP_PASSWORD_SHA256=replace-with-sha256
CONTROL_PASSWORD_SHA256=replace-with-sha256
SESSION_SECRET=replace-with-random-hex-32-plus-bytes
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
